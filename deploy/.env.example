# 운영 서버의 deploy/.env 예시. 복사해서 채운다: cp .env.example .env
# deploy/.env 는 저장소에 올리지 않는다. 값에 $ 를 쓰지 않는다(compose 가 변수로 읽는다).

# ── 접속 주소 ──
# Caddy 가 여는 주소. 공인 DNS 이름이면 HTTPS 인증서를 자동으로 받는다. 사내 이름·IP 는 http:// 를 붙인다.
SITE_ADDRESS=sketch.example.com
# 재설정 메일·MCP 응답에 쓰는 주소(필수). SITE_ADDRESS 와 같은 곳을 https:// 또는 http:// 로.
APP_URL=https://sketch.example.com

# ── 비밀값 ──
# DB 비밀번호: 영문·숫자만(주소에 그대로 들어간다). 예: openssl rand -hex 24
# 처음 켠 뒤에 바꾸면 DB 쪽 비밀번호도 함께 바꿔야 한다(docs/deploy.md).
POSTGRES_PASSWORD=
# 로그인 세션 서명 키: 32자 이상(짧으면 앱이 켜지지 않는다). 예: openssl rand -hex 32
AUTH_SECRET=

# ── 앞단 프록시 ──
# Caddy 한 겹이면 1(기본). 사내 프록시 → Caddy 라면 Caddyfile 의 trusted_proxies 를 먼저 설정한다.
TRUSTED_PROXY_HOPS=1

# ── 메일(비밀번호 재설정) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 메일 서버 없이 쓸 때만 1: 재설정 링크를 앱 로그(docker compose logs app)에 남긴다.
RESET_LINK_LOG=

# ── AI 서버(비우면 AI 기능만 꺼진다) ──
QWEN_CODER_KEY=
QWEN_MODEL=
QWEN_API_URL=
CLEF_API_KEY=
CLEF_API_URL=
CLEF_MAX_CONCURRENCY=

# ── 백업 ──
# 백업 파일을 둘 곳. 서버 디스크를 통째로 잃는 경우에 대비하려면 다른 디스크·NAS 경로를 쓴다.
BACKUP_DIR=./backups
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=7

# ── 포트(보통은 그대로) ──
HTTP_PORT=80
HTTPS_PORT=443
