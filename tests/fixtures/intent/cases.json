    { "id": "m-edge-api-two", "text": "API, 양방향", "want": "missing_info_answer", "lastAssistant": "WAS → 외부 인증 연결의 전달물과 방향을 알려 주세요.", "qwen": { "expect": "edge", "edge": "e-was-auth", "payload": "api", "direction": "two_way" } },
    { "id": "m-edge-file-short", "text": "파일로 한쪽만 보내", "want": "missing_info_answer", "lastAssistant": "WAS → 외부 인증 연결의 전달물과 방향을 알려 주세요.", "qwen": { "expect": "edge", "edge": "e-was-auth", "payload": "file", "direction": "one_way" } },
    { "id": "m-node-spec", "text": "WAS는 4코어 16기가", "want": "missing_info_answer", "lastAssistant": "WAS의 CPU·RAM을 알려 주세요.", "qwen": { "expect": "node_attr", "node": "was" } },

    { "id": "l-relayout", "text": "보기 좋게 다시 배치해 줘", "want": "layout", "qwen": { "expect": "skip" } }
