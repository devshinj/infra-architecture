    {
      "id": "order", "name": "주문하기", "origin": "user", "summary": "주문을 받아 DB에 남긴다", "result": "주문 접수",
      "steps": [
        { "edge": "e-user-fw", "from": "user", "short": "주문 요청", "text": "주문 정보를 보낸다" },
        { "edge": "e-fw-web", "from": "fw", "short": "방화벽 통과", "text": "허용된 요청만 웹 서버로 간다" },
        { "edge": "e-web-was", "from": "web", "short": "WAS 전달", "text": "웹 서버가 WAS로 넘긴다" },
