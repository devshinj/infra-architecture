    { "op": "add_edge", "id": "e-was-auth", "from": "was", "to": "auth", "edge_kind": "request", "label": "본인 확인" },
    { "op": "add_edge", "id": "e-batch-db", "from": "batch", "to": "db", "edge_kind": "async", "label": "야간 집계" }
