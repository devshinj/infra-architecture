    { "op": "add_edge", "id": "e-web-was", "from": "web", "to": "was", "edge_kind": "request", "label": "업무 처리" },
    { "op": "add_edge", "id": "e-was-db", "from": "was", "to": "db", "edge_kind": "request", "label": "회원 정보 저장" },
