QWEN_CODER_KEY=
QWEN_MODEL=
QWEN_API_URL=
CLEF_API_KEY=
CLEF_API_URL=
# 필수: 예) postgres://postgres:postgres@localhost:5432/infrasketch
DATABASE_URL=
DATABASE_URL_TEST=
# 필수: `npx auth secret` 또는 32자 이상의 임의 문자열 (운영에서 32자 미만이면 서버가 켜지지 않는다)
AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 운영에서 메일 서버 없이 쓸 때만 1: 재설정 링크를 서버 로그에 남긴다
RESET_LINK_LOG=
# 운영에서는 필수: 재설정 메일과 MCP 응답의 링크에 쓰인다
APP_URL=
# 앞단 프록시 수(한 겹이면 1, 없으면 0). 비우면 x-forwarded-for 의 첫 값을 믿는다
TRUSTED_PROXY_HOPS=
